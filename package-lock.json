{
  "name": "traceline",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "traceline",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "name": "@traceline/api",
      "version": "0.0.0"
    },
    "apps/extension": {
      "name": "@traceline/extension",
      "version": "0.0.0"
    },
    "apps/web": {
      "name": "@traceline/web",
      "version": "0.0.0"
    },
    "node_modules/@traceline/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@traceline/extension": {
      "resolved": "apps/extension",
      "link": true
    },
    "node_modules/@traceline/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@traceline/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/zod": {
      "version": "3.25.76",
      "resolved": "https://registry.npmjs.org/zod/-/zod-3.25.76.tgz",
      "integrity": "sha512-gzUt/qt81nXsFGKIFcC3YnfEAx5NkunCfnDlvuBSSFS02bcXu4Lmea0AFIUwbLWxWPx3d9p8S5QoaujKcNQxcQ==",
      "license": "MIT",
      "funding": {
        "url": "https://github.com/sponsors/colinhacks"
      }
    },
    "packages/shared": {
      "name": "@traceline/shared",
      "version": "0.0.0",
      "dependencies": {
        "zod": "^3.23.8"
      }
    }
  }
}
